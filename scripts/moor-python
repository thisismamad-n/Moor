#!/usr/bin/env bash
# Run Python in this checkout's environment: `scripts/moor-python ARGS...`.
#
# A GitHub Actions job runs the interpreter setup-pm exported as MOOR_PYTHON,
# so a recipe never re-runs setup on a runner. Anywhere else MOOR_PYTHON may
# be inherited from a wrapped `moor` (a release venv without the dev tools),
# so scripts/run-in-moor-env applies (and if stale, syncs) the environment
# `source ./activate` gives a shell.
set -euo pipefail

if [ "${GITHUB_ACTIONS:-}" = true ] && [ -z "${__MOOR_ACTIVATED:-}" ] && [ -n "${MOOR_PYTHON:-}" ] \
    && [ -x "$MOOR_PYTHON" ]; then
    exec "$MOOR_PYTHON" "$@"
fi
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/run-in-moor-env" python "$@"
