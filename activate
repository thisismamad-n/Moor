#!/usr/bin/env bash
# ============================================================================
# venv-style activation for the Moor dev environment (pm-managed tools).
#
#   source ./activate      (bash / zsh, repo root)
#   .\activate.ps1         (PowerShell)
#
# Emits the composed pm env (PATH + tool vars) into the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `moor` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `moor pm
# install` and `moor update` keep that check.
# ============================================================================
_MOOR_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_moor_test_env="--test-environment"
_moor_expect_extras=""
for _moor_arg in "$@"; do
    if [ -n "$_moor_expect_extras" ]; then
        _moor_test_env="--test-environment=$_moor_arg"
        _moor_expect_extras=""
        continue
    fi
    case "$_moor_arg" in
        --) break ;;
        --test-extras) _moor_expect_extras=1 ;;
        --test-extras=*) _moor_test_env="--test-environment=${_moor_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_moor_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _moor_arg _moor_test_env _moor_expect_extras
    return 2 2>/dev/null || exit 2
fi
# Setup runs in a child: failures must not exit or partially activate the
# caller's shell, and activation must not republish launchers or shell config.
if ! (
    unset PYTHONHOME PYTHONPATH VIRTUAL_ENV
    bash "$_MOOR_REPO/setup-moor.sh" --runtime-only "$_moor_test_env"
) >&2; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _moor_arg _moor_test_env _moor_expect_extras
    return 1 2>/dev/null || exit 1
fi
unset _moor_arg _moor_test_env _moor_expect_extras

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __MOOR_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

# Bootstrap Python only emits the environment; it does not install anything.
_moor_repo="$_MOOR_REPO"
_moor_py=""
for _moor_candidate in "$_moor_repo/.venv/bin/python" "$_moor_repo/.venv/Scripts/python.exe" \
                         "$_moor_repo/venv/bin/python" "$_moor_repo/venv/Scripts/python.exe"; do
    [ -x "$_moor_candidate" ] && { _moor_py="$_moor_candidate"; break; }
done
if [ -z "$_moor_py" ]; then
    for _moor_store in "${MOOR_RUNTIME_DIR:-}" "$_moor_repo/../tools" "${MOOR_HOME:-$HOME/.moor}/tools"; do
        [ -n "$_moor_store" ] || continue
        for _moor_candidate in "$_moor_store"/python-*/bin/python3 "$_moor_store"/python-*/python.exe "$_moor_store"/python-*/bin/python "$_moor_store"/python-*/bin/python.exe; do
            [ -x "$_moor_candidate" ] && { _moor_py="$_moor_candidate"; break; }
        done
        [ -n "$_moor_py" ] && break
    done
fi
if [ -z "$_moor_py" ]; then
    echo "activate: no bootstrap Python found; run setup-moor.sh" >&2
    return 1 2>/dev/null || exit 1
fi

# --- emit export lines from `pm env` ---
_moor_json="$(PYTHONHOME= PYTHONPATH="$_moor_repo" "$_moor_py" -m pm.environments)"
if [ -z "$_moor_json" ] || [ "${_moor_json#*{}" = "$_moor_json" ]; then
    echo "activate: could not read pm env (run ./setup-moor.sh first)" >&2
    unset _moor_repo _moor_os _moor_arch _moor_target _moor_store _moor_py _moor_json
    return 1 2>/dev/null || exit 1
fi

_moor_keys="$(printf '%s' "$_moor_json" | "$_moor_py" -c 'import json,sys; print(" ".join(json.load(sys.stdin)))' \
    | tr ' ' '\n' | grep -E '^[A-Za-z_][A-Za-z0-9_]*$' | tr '\n' ' ')"
[ -n "$_moor_keys" ] || _moor_keys="PATH"

# --- snapshot what we are about to change (deactivate restores this) ---
# __MOOR_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__MOOR_SAVED_PATH="$PATH"
for _moor_k in $_moor_keys; do
    eval "__MOOR_SAVED_$_moor_k=\"\${$_moor_k+set}\""
    eval "__MOOR_PRIOR_$_moor_k=\${$_moor_k-__MOOR_UNSET__}"
done

# Resolved before the export below replaces PATH.
_moor_cygpath="$(command -v cygpath 2>/dev/null || :)"

eval "$(printf '%s' "$_moor_json" | "$_moor_py" -c '
import json, sys, shlex, re
for k, v in json.load(sys.stdin).items():
    # Windows carries names like ProgramFiles(ARM) that are not valid
    # bash identifiers — skip them (they pass through untouched).
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k):
        continue
    print("export %s=%s" % (k, shlex.quote(str(v))))')"

# The MSYS/Cygwin runtime hands a native Windows Python these variables in
# Windows form (`C:\a;C:\b`) and converts them back only for its own children.
# Exported verbatim, bash splits PATH on ':' and finds no commands.
if [ -n "$_moor_cygpath" ]; then
    PATH="$("$_moor_cygpath" -u -p "$PATH")"
    for _moor_k in HOME TMPDIR TMP TEMP; do
        if [ -n "${!_moor_k-}" ]; then
            printf -v "$_moor_k" '%s' "$("$_moor_cygpath" -u "${!_moor_k}")"
        fi
    done
fi

# This checkout, not whichever `moor` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__MOOR_WORKTREE="$_moor_repo"
# The branch names the worktree. A checkout cannot share a branch with another.
__MOOR_WORKTREE_NAME="$(git -C "$_moor_repo" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__MOOR_WORKTREE_NAME" ] || [ "$__MOOR_WORKTREE_NAME" = HEAD ]; then
    __MOOR_WORKTREE_NAME="$(basename "$_moor_repo")"
fi
__MOOR_SAVED_PS1="${PS1-__MOOR_UNSET__}"
__MOOR_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__MOOR_UNSET__}"

_moor_worktree_here() {
    _moor_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_moor_top" && pwd -P)" = "$(cd "$__MOOR_WORKTREE" && pwd -P)" ]
}

moor() {
    _moor_worktree_here || {
        printf '%s\n' "moor: $(pwd) is outside $__MOOR_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__MOOR_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" moor "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe moor "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python moor "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe moor "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python moor "$@"
        else
            exec python moor "$@"
        fi
    )
}

_moor_prompt() {
    if [ "$__MOOR_SAVED_PS1" = "__MOOR_UNSET__" ]; then
        _moor_base_ps1=""
    else
        _moor_base_ps1="$__MOOR_SAVED_PS1"
    fi
    if _moor_worktree_here; then
        PS1="($__MOOR_WORKTREE_NAME) $_moor_base_ps1"
    else
        PS1="$_moor_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_moor_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_moor_prompt
fi
_moor_prompt

deactivate() {
    export PATH="$__MOOR_SAVED_PATH"
    for _moor_k in $__MOOR_KEY_LIST; do
        eval "_moor_was=\"\$__MOOR_SAVED_$_moor_k\""
        eval "_moor_old=\"\$__MOOR_PRIOR_$_moor_k\""
        if [ "$_moor_was" != "set" ]; then
            unset "$_moor_k"
        else
            export "$_moor_k=$_moor_old"
        fi
        unset "__MOOR_SAVED_$_moor_k" "__MOOR_PRIOR_$_moor_k"
    done
    if [ "$__MOOR_SAVED_PS1" = "__MOOR_UNSET__" ]; then
        unset PS1
    else
        PS1="$__MOOR_SAVED_PS1"
    fi
    if [ "$__MOOR_SAVED_PROMPT_COMMAND" = "__MOOR_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__MOOR_SAVED_PROMPT_COMMAND"
    fi
    unset __MOOR_SAVED_PATH __MOOR_KEY_LIST __MOOR_ACTIVATED \
          __MOOR_WORKTREE __MOOR_WORKTREE_NAME \
          __MOOR_SAVED_PS1 __MOOR_SAVED_PROMPT_COMMAND
    unset -f deactivate moor _moor_worktree_here _moor_prompt
    unset _moor_k _moor_was _moor_old _moor_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__MOOR_KEY_LIST="$_moor_keys"

unset _moor_repo _moor_os _moor_arch _moor_target _moor_store \
      _moor_py _moor_json _moor_keys _moor_k _moor_entry _moor_venvpy \
      _moor_winarch _moor_top _moor_cygpath
